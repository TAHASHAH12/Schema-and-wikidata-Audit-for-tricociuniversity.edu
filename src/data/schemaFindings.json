 "defects": [
  {
   "id": "campus-address",
   "severity": "Critical",
   "pages": 52,
   "title": "Campus pages give the head-office address, not their own",
   "detail": "52 of 68 campus pages carry only the Park Ridge corporate address in their markup. Sitewide, 611 of 670 pages assert it. Every campus page therefore tells Google the school is located in Park Ridge, which is the one thing a multi-location school must get right.",
   "fix": "Emit a per-campus Place with that campus's own streetAddress, geo coordinates and telephone, and reference it from the campus page's primary entity."
  },
  {
   "id": "programs-itemlist",
   "severity": "Critical",
   "pages": 1,
   "title": "Five valid Course pages, no carousel markup to make them eligible",
   "detail": "5 programme pages carry well-formed Course markup with provider, prerequisites, credential awarded and course instances. Google's course list rich result needs at least three courses plus ItemList markup on a summary page. /programs/ is marked up as an Article and there is no ItemList anywhere on the site.",
   "fix": "Add ItemList markup to /programs/ referencing the five Course URLs. The Course data already qualifies."
  },
  {
   "id": "campus-not-local",
   "severity": "High",
   "pages": 68,
   "title": "Campuses are not marked up as places of business",
   "detail": "All 68 campus pages inherit the sitewide CollegeOrUniversity node. None declares itself a distinct location with its own geo coordinates, opening hours or contact point. Only 18 carry an AggregateRating and those sit on a Product node rather than the organisation.",
   "fix": "Give each campus a School or LocalBusiness node with geo, openingHoursSpecification, telephone and areaServed, linked to the parent organisation with parentOrganization."
  },
  {
   "id": "product-rating",
   "severity": "High",
   "pages": 10,
   "title": "A school is marked up as a Product carrying a rating with no offer",
   "detail": "10 pages declare a Product named things like 'Cosmetology School' with an aggregateRating and no offers. Product is for goods and services with a price; a campus is not one. An aggregateRating on a Product with no offer is also the pattern Google's own guidance warns about.",
   "fix": "Move the rating onto the EducationalOrganization or School node for that campus and drop the Product type."
  },
  {
   "id": "no-occupation",
   "severity": "High",
   "pages": 4,
   "title": "Career pages never say which occupation they are about",
   "detail": "Four programme career-path pages describe the job a graduate does, and no page on the site carries Occupation markup or an occupationalCategory. This is the clearest entity signal in vocational education and no competitor in this set uses it either.",
   "fix": "Add Occupation markup with occupationalCategory (O*NET-SOC) and a Wikidata sameAs on each career-path page, and occupationalCredentialAwarded on the programme."
  },
  {
   "id": "program-subpages",
   "severity": "Medium",
   "pages": 15,
   "title": "Programme sub-pages are typed as generic Articles",
   "detail": "15 pages under /programs/ \u2014 curriculum, career path, schedule, instructor profiles \u2014 are typed as Article. They are parts of an educational programme, not editorial content.",
   "fix": "Type curriculum pages as Syllabus or a Course part, and link sub-pages to their parent Course with hasPart / isPartOf."
  },
  {
   "id": "clinic-services",
   "severity": "Medium",
   "pages": 3,
   "title": "The student salon is marked up as an Article",
   "detail": "The clinic pages sell real services to the public \u2014 the salon locations page alone draws an estimated 1,198 visits a month \u2014 but they are typed as Article with the sitewide organisation attached.",
   "fix": "Type these as HealthAndBeautyBusiness with a Service and Offer per treatment, priceRange, and the campus location."
  },
  {
   "id": "faq-deprecated",
   "severity": "Low",
   "pages": 28,
   "title": "FAQ markup no longer earns a rich result",
   "detail": "28 pages carry FAQPage. Google removed the FAQ rich result from Search on 7 May 2026, and FAQ no longer appears in the search gallery. The markup is still worth keeping for entity clarity and AI citation, but it should not be counted as a SERP feature.",
   "fix": "Keep the markup, reset the expectation. Do not report it as a rich-result win."
  }
 ],
